{
  "name": "@reactlens/diagnostics",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fausto95/react-lens.git",
    "directory": "packages/diagnostics"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --tsconfig tsconfig.build.json"
  },
  "dependencies": {
    "@oxc-parser/binding-wasm32-wasi": "0.144.0",
    "@reactlens/protocol": "workspace:*",
    "oxc-parser": "^0.144.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
