{
  "name": "@reactlens/dev-channel",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fausto95/react-lens.git",
    "directory": "packages/dev-channel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite-plugin.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite-plugin.d.ts",
        "default": "./dist/vite-plugin.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/vite-plugin.ts --format esm --dts --sourcemap --clean --tsconfig tsconfig.build.json"
  },
  "dependencies": {
    "@reactlens/protocol": "workspace:*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.14",
    "tsup": "^8.5.1",
    "vite": "catalog:"
  }
}
