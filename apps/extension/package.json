{
  "name": "@reactlens/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build && vp build --config vite.injected.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reactlens/causality": "workspace:*",
    "@reactlens/devtools": "workspace:*",
    "@reactlens/fiber": "workspace:*",
    "@reactlens/instrumentation": "workspace:*",
    "@reactlens/protocol": "workspace:*",
    "@reactlens/serializer": "workspace:*",
    "@reactlens/trace-engine": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.287",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
