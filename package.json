{
  "name": "react-lens",
  "version": "0.0.0",
  "private": true,
  "description": "Know why every render happened. Dev-time React observability \u2014 from interaction to cause to fix.",
  "type": "module",
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit || true",
    "dev:playground": "pnpm --filter @react-lens/playground dev",
    "dev:devtools": "pnpm --filter @react-lens/devtools dev",
    "dev:site": "pnpm --filter @react-lens/site dev",
    "build:extension": "pnpm --filter @react-lens/extension build",
    "build:site": "pnpm --filter @react-lens/site build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^15.11.7",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  }
}
