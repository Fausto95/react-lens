{
  "name": "reactlens",
  "version": "0.0.0",
  "private": true,
  "description": "Rewind any render. Then ask why. Dev-time React observability with real time travel and a trace-grounded AI agent.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp check",
    "check:compiled": "node scripts/check-compiled.mjs",
    "check:compiled:build": "pnpm build:extension && node scripts/check-compiled.mjs --bundle apps/extension/dist",
    "dev:playground": "pnpm --filter @reactlens/playground dev",
    "dev:e2e-fixture": "pnpm --filter @reactlens/e2e-fixture dev",
    "dev:devtools": "pnpm --filter @reactlens/devtools dev",
    "dev:site": "pnpm --filter @reactlens/site dev",
    "build:extension": "pnpm --filter @reactlens/extension build",
    "package:extension": "pnpm build:extension && cd apps/extension/dist && zip -r ../reactlens-extension.zip .",
    "build:site": "pnpm --filter @reactlens/site build",
    "og:site": "pnpm --filter @reactlens/site og",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "1.60.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.11.2",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
      "vitest": "4.1.10"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
